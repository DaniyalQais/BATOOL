# Used by the build-time catalog and to configure browser Auth.
# Only the validated URL and publishable key are exposed as NEXT_PUBLIC_* by Next config.
CATALOG_SOURCE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Never use a secret/service-role key here. No extra auth dependency is needed.
# Explicit offline design preview: CATALOG_SOURCE=demo (not an auth bypass).
