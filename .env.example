# Used by the build-time catalog/public settings RPC and to configure browser Auth.
# Next exposes the validated public Auth configuration and optional loopback preview URL only.
CATALOG_SOURCE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Never use a secret/service-role key here. No extra auth dependency is needed.
# Explicit offline design preview: CATALOG_SOURCE=demo (not an auth bypass).
# Public contact details belong in Owner settings, not environment variables.
# Public settings saves require rebuilding/publishing. Live builds require migration 008.
# Optional disposable checkout form tests ONLY; omit from production builds.
# BATOOL_LOCAL_CHECKOUT_URL=http://127.0.0.1:43179
# Checkout service keys, scope signing secrets and operational gates belong ONLY
# in the prepared backend runtime; never add them to this Next/public environment.
# Optional production wiring: exact HTTPS function URL in the SAME configured project.
# BATOOL_CHECKOUT_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/secure-checkout
# Keep both public release flags false until separately approved publication/intake.
BATOOL_CHECKOUT_RELEASE=false
BATOOL_RECOVERY_RELEASE=false
# Product media has a separate reviewed deployment/readiness gate. No checkout activation.
BATOOL_PRODUCT_MEDIA_RELEASE=false
# Backend only (not Next/public variables): BATOOL_RECOVERY_ENABLED=false.
